{
  "name": "see-vivaldi",
  "version": "1.0.0",
  "description": "Enhanced visual accessibility for internal Vivaldi pages",
  "main": "src/scripts/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "postbuild": "node scripts/deploy.js",
    "deploy": "node scripts/deploy.js",
    "monitor": "node scripts/updates-handler/vivaldi-monitor.js",
